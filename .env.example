# Copie para .env.local (ignorado pelo git). Sem estas duas variáveis a autenticação fica desligada
# e o app mostra só os dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=[ASSIM: URL do projeto Supabase]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[ASSIM: chave publicável (sb_publishable_...)]

# NUNCA coloque a chave secreta (service_role) em NEXT_PUBLIC_*. Quando os jobs de sincronização
# existirem, ela vai em SUPABASE_SERVICE_ROLE_KEY, só no servidor.
