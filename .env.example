# Copie para .env.local (ignorado pelo git). Sem estas duas variáveis a autenticação fica desligada
# e o app mostra só os dados de exemplo.
NEXT_PUBLIC_SUPABASE_URL=[ASSIM: URL do projeto Supabase]
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[ASSIM: chave publicável (sb_publishable_...)]

# NUNCA coloque a chave secreta (service_role) em NEXT_PUBLIC_*. Quando os jobs de sincronização
# existirem, ela vai em SUPABASE_SERVICE_ROLE_KEY, só no servidor.

# --- Conexão com o Meta Ads (somente servidor; nunca em NEXT_PUBLIC_*) ---
META_APP_ID=[ASSIM: ID do app na Meta]
META_APP_SECRET=[ASSIM: chave secreta do app, nunca no repositório]
# ID da configuração do Login do Facebook para Empresas (opcional; sem ele o login pede ads_read direto)
META_LOGIN_CONFIG_ID=[ASSIM: config_id]
# Versão da Graph API (padrão v23.0)
META_GRAPH_VERSION=v23.0
# Chave de 32 bytes em base64 que cifra os tokens. Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=[ASSIM: chave gerada]
# Chave de serviço do Supabase: ignora a RLS. Só no servidor.
SUPABASE_SERVICE_ROLE_KEY=[ASSIM: service_role]
# Endereço público do app (usado no retorno do login). Ex.: https://kavro.exemplo.com
APP_URL=[ASSIM: URL pública]
